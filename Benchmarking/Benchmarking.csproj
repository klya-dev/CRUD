  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.8" />
    <PackageReference Include="stbychkov.AutoLoggerMessage" Version="1.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CRUD.Models\CRUD.Models.csproj" />
    <ProjectReference Include="..\CRUD.Tests\CRUD.Tests.csproj" />
  </ItemGroup>

</Project>
