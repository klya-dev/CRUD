{
  "parallelizeAssembly": true, // Данная сборка может выполняться параллельно с другими сборками
  "parallelizeTestCollections": true // Включает параллельное выполнение тестов внутри данной сборки (тесты одной коллекции выполняются последовательно)
}

// ОБЯЗАТЕЛЬНО в свойствах указать копирование в сборку

// Теперь все тесты выполняются параллельно, а для распараллелизации интеграционных тестов, я использую коллекцию "IntegrationTests"

// Без коллекций тесты работали нестабильно, т.к у Visual Studio свой движок тестов - для него приоритет .runsettings, у xUnit приоритет xunit.runner.json
// Поэтому я явно указываю коллекцию "IntegrationTests" в тестах xUnit, которую Visual Studio физически распараллелить не сможет